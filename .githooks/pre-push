#!/bin/bash
# Pre-push hook — run lint check. Block push only on compilation errors.
set -euo pipefail

ROOT_DIR="$(git rev-parse --show-toplevel 2>/dev/null)"
SCRIPT="$ROOT_DIR/scripts/lint-to-issues.sh"

if ! command -v golangci-lint &>/dev/null; then
  echo "⚠️  golangci-lint not installed, skipping"
  exit 0
fi

echo "🔍 Running golangci-lint..."
REPORT=$(mktemp)
trap 'rm -f "$REPORT"' EXIT

golangci-lint run ./... --out-format json > "$REPORT" 2>/dev/null || true
ERRORS=$(jq '.Issues | length' "$REPORT" 2>/dev/null || echo 0)

if [[ "$ERRORS" -gt 0 ]]; then
  echo ""
  echo "⚠️  ⚠️  ⚠️  Найдено $ERRORS ошибок линтинга ⚠️  ⚠️  ⚠️ "
  echo ""
  jq -r '.Issues[] | "  • \(.Pos.Filename):\(.Pos.Line)  \(.FromLinter)  \(.Text)"' "$REPORT" 2>/dev/null
  echo ""
  echo "Issue будет создан/обновлён автоматически после push."
  echo "Подробнее: https://github.com/X-didgital/$(basename "$ROOT_DIR")/issues?q=lint"
  echo ""

  # Create/update issue silently
  if [[ -f "$SCRIPT" ]]; then
    "$SCRIPT" 2>/dev/null || true
  fi
fi

exit 0
